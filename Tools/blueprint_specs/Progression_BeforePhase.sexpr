(fn BeforePhase ()
 (bind p (Local|BP_RA_ProgressionTest|GetTestPlayer))(bind far (Local|BP_RA_ProgressionTest|GetFarRobot))
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (< (Local|BP_RA_PlayerCharacter|GetPlayerHealth :self p) 100.0) :Label "PROGRESSION_PASS robot_attacks_player")
 (bind location (Transformation|GetActorLocation :self far))
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (> (.x location) -650.0) :Label "PROGRESSION_PASS robot_navigates_toward_player")
(Local|BP_RA_ProgressionTest|CheckProgression :Condition (or (> (.y location) 20.0) (< (.y location) -20.0)) :Label "PROGRESSION_PASS robot_navigates_around_wall")
 (bind robots (Actor|GetAllActorsOfClass :ActorClass "/Game/RicochetArena/Progression/BP_RA_HunterRobot.BP_RA_HunterRobot_C"))
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (== (Utilities|Array|Length :TargetArray robots) 3) :Label "PROGRESSION_PASS spawning_respects_alive_limit")
 (Local|BP_RA_RobotDirector|SetSpawningEnabled :self (Local|BP_RA_ProgressionTest|GetTestDirector) :SpawningEnabled false)
 (for robot robots (Local|BP_RA_HunterRobot|SetAttackDamage :self robot :AttackDamage 0.0))

 (bind sourceBullet (Game|SpawnActorfromClass :Class "/Game/RicochetArena/CoreMechanics/BP_RA_RicochetProjectile.BP_RA_RicochetProjectile_C" :SpawnTransform (Math|Transform|MakeTransform :Location (Math|Vector|MakeVector :X -1500 :Y 1500 :Z 300)) :CollisionHandlingOverride "AlwaysSpawn"))
 (Local|BP_RA_RicochetProjectile|SetHasRicocheted :self sourceBullet :HasRicocheted true)
 (for victim robots
  (if (and (!= victim far) (!= victim (Local|BP_RA_ProgressionTest|GetCloseRobot)))
   (Local|BP_RA_TestRobot|ReceiveProjectileDamage :self victim :IncomingDamage 25.0 :Source sourceBullet)
   (Local|BP_RA_TestRobot|ReceiveProjectileDamage :self victim :IncomingDamage 25.0 :Source sourceBullet)
   (Local|BP_RA_TestRobot|ReceiveProjectileDamage :self victim :IncomingDamage 25.0 :Source sourceBullet)
   (Local|BP_RA_TestRobot|ReceiveProjectileDamage :self victim :IncomingDamage 25.0 :Source sourceBullet)
   (Local|BP_RA_ProgressionTest|CheckProgression :Condition (Local|BP_RA_TestRobot|GetIsDead :self victim) :Label "PROGRESSION_PASS hunter_dies_after_four_ricochet_damage_events")
   (Local|BP_RA_TestRobot|ReceiveProjectileDamage :self victim :IncomingDamage 25.0 :Source sourceBullet)))
 (bind resources (Actor|GetAllActorsOfClass :ActorClass "/Game/RicochetArena/CoreMechanics/BP_RA_Microchip.BP_RA_Microchip_C"))
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (== (Utilities|Array|Length :TargetArray resources) 1) :Label "PROGRESSION_PASS hunter_drops_one_resource")
 (for resource resources
  (Local|BP_RA_ProgressionTest|CheckProgression :Condition (== (Local|BP_RA_Microchip|GetValue :self resource) 5) :Label "PROGRESSION_PASS drop_value_is_five")
  (Local|BP_RA_Microchip|TryCollect :self resource :Collector p))
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (== (Local|BP_RA_PlayerCharacter|GetMicrochips :self p) 80) :Label "PROGRESSION_PASS kill_resource_funds_upgrades")
 (bind closeVictim (Game|SpawnActorfromClass :Class "/Game/RicochetArena/Progression/BP_RA_HunterRobot.BP_RA_HunterRobot_C" :SpawnTransform (Math|Transform|MakeTransform :Location (Math|Vector|MakeVector :X 0 :Y 100 :Z 85)) :CollisionHandlingOverride "AlwaysSpawn"))
 (Local|BP_RA_TestRobot|ReceiveProjectileDamage :self closeVictim :IncomingDamage 25.0 :Source sourceBullet)
 (Local|BP_RA_TestRobot|ReceiveProjectileDamage :self closeVictim :IncomingDamage 25.0 :Source sourceBullet)
 (Local|BP_RA_TestRobot|ReceiveProjectileDamage :self closeVictim :IncomingDamage 25.0 :Source sourceBullet)
 (Local|BP_RA_TestRobot|ReceiveProjectileDamage :self closeVictim :IncomingDamage 25.0 :Source sourceBullet)
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (== (Local|BP_RA_PlayerCharacter|GetMicrochips :self p) 85) :Label "PROGRESSION_PASS immediate_pickup_uses_initialized_drop_value")

 (Local|BP_RA_ProgressionTest|SetHealthBeforePhase :HealthBeforePhase (Local|BP_RA_PlayerCharacter|GetPlayerHealth :self p))
 (Local|BP_RA_PlayerCharacter|TryActivateStealth :self p)
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (Local|BP_RA_PlayerCharacter|GetStealthActive :self p) :Label "PROGRESSION_PASS stealth_activates")
 (Local|BP_RA_ProgressionTest|SetPhaseStart :PhaseStart (Utilities|Time|GetGameTimeinSeconds))
 (Local|BP_RA_ProgressionTest|SetReadyTime :ReadyTime (Local|BP_RA_PlayerCharacter|GetNextStealthReady :self p))
 (Local|BP_RA_ProgressionTest|SetStoppedLocation :StoppedLocation location)
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (== (Local|BP_RA_PlayerCharacter|GetNextStealthReady :self p) (+ (Local|BP_RA_ProgressionTest|GetPhaseStart) 30.0)) :Label "PROGRESSION_PASS cooldown_is_thirty_seconds")
 (bind material (Rendering|Material|GetMaterial :self (Local|BP_RA_PlayerCharacter|GetBodyVisual :self p)))
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (== material (Local|BP_RA_PlayerCharacter|GetPhaseMaterial :self p)) :Label "PROGRESSION_PASS phase_material_applied")
 (Local|BP_RA_PlayerCharacter|TryActivateStealth :self p)
 (Local|BP_RA_ProgressionTest|CheckProgression :Condition (== (Local|BP_RA_PlayerCharacter|GetNextStealthReady :self p) (Local|BP_RA_ProgressionTest|GetReadyTime)) :Label "PROGRESSION_PASS cannot_restart_active_ability")
 (Local|BP_RA_ProgressionTest|SetStage :Stage 1))